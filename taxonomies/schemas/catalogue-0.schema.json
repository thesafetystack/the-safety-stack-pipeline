{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalogue-0.schema.json",
  "title": "Catalogue envelope, major version 0 (the structure the taxonomy files share)",
  "description": "version, meta, one entries list with the core entry fields. Each catalogue's own schema (<name>/schemas/<name>-<n>.schema.json) refers to this one and closes the shape; meta.schema names it. A schema's number counts structure versions of that catalogue and is independent of the file's content version (models 1.1.0 is schema models-2).",
  "type": "object",
  "required": ["version", "meta", "entries"],
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "meta": {
      "type": "object",
      "required": ["schema", "updated", "status"],
      "properties": {
        "schema": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(-[a-z][a-z0-9_]*)*-[0-9]+$"},
        "updated": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "status": {"enum": ["draft", "released"]},
        "description": {"type": "string"},
        "sources": {"type": "object", "additionalProperties": {"type": "string"}},
        "references": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"},
                       "additionalProperties": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}
      }
    },
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"},
    "text": {"type": "string", "minLength": 1},
    "alias": {
      "oneOf": [
        {"$ref": "#/$defs/text"},
        {"type": "object", "required": ["text"], "additionalProperties": false,
         "properties": {"text": {"$ref": "#/$defs/text"}, "kind": {"$ref": "#/$defs/id"}}}
      ]
    },
    "ref": {
      "type": "object", "required": ["id", "name"], "additionalProperties": false,
      "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/text"}}
    },
    "entry": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"$ref": "#/$defs/text"},
        "parent": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
        "aliases": {"type": "array", "items": {"$ref": "#/$defs/alias"}},
        "note": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]},
        "external_ids": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"},
                         "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/text"}}}
      }
    }
  }
}
