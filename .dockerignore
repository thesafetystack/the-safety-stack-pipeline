# The image holds code and configs only (Dockerfile, docs/DEPLOY-railway.md). Never secrets, stores or a venv.
.env
**/.env
.env.*
!.env.example
.local
**/.local
data
**/data
# ...but the archived release formats' schemas the export compares against (data-repo/formats/<x.y>/data/, D805)
!data-repo/formats/*/data
!data-repo/formats/*/data/**
v4/mirror
v4/store-*
.venv
**/.venv
.git
**/__pycache__
**/*.pyc
.mypy_cache
.pytest_cache
.ruff_cache
# not read at run time
docs
tests
