/researchers.csv

# ---- os cruft ----
.DS_Store

# ============================================================
# GitHub Python template
# ============================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
