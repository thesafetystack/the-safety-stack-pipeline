#
CLAUDE.md
# ---- Claude Code agent worktrees (ephemeral, machine-local) ----
.claude/worktrees/

# affiliation eval harness scratch output (cached LLM responses + scored CSVs)
affiliation_classification_evals/
eval-out*/
eval-out*.log

# Machine-local Dropbox sync helper (Linux-only: needs `attr`). Only useful if you
# happen to keep this repo inside a Dropbox folder, so it doesn't belong in the
# shared repo. Untracked via `git rm --cached`, kept on disk.
dropbox-ignore.sh
.env.local

# v4 dev store (D29): local only, never committed.
v4/store-dev/
# S3 store mirrors ($STACK_MIRROR default, T-STORE D321): local copies of s3:// stores, never committed
v4/mirror/
# T-STORE conductor (2026-10): end-to-end copies of stores for the S3 check (local only, never committed)
v4/store-tstore-*/
v4/evals-store/
# track A2 scratch store for SR-source collector windows (reflink copy of store-dev; never committed)
v4/store-sr-scratch/
# track X (round 4): scratch store for live X lookups (local only, never committed)
v4/store-x-scratch/
# track L (round 4): link-collection scratch store (feeds, manual sources, links; local only, never committed)
v4/store-links-scratch/
# track P (round 4, B7): reflink copy of store-dev for the real 2-pass screen-v11 build (local only, never committed)
v4/store-p5-dev/
# track RUN (round 5): reflink copies of store-dev for throughput and structured-text runs (local only, never
# committed; reflink needs the same btrfs volume, so they live here, not in /tmp)
v4/store-run-*/
# track T-S3 (round 5): reflink copy of store-dev with its blobs pushed to the blob bucket (local only, never committed)
v4/store-s3-scratch/
# track T-ANN (round 5): reflink copy of store-p5-dev for the model_mentions/model_roles/technique_roles real runs (local only, never committed)
v4/store-ann-scratch/
# track T-ID (round 5): reflink copies of the dev/sr/links stores for the duplicate-detection check (local only, never committed)
v4/store-id-*/
# track T-FIX (round 5): reflink copies of store-dev for the gather drift and identity checks (local only, never committed)
v4/store-fix-*/
# track T-REH (round 5): the std-v3 rehearsal store (7-day window, S3 blob backend; local only, never committed)
v4/store-reh-*/
# track T-R6 (round 5): reflink copies of store-reh-7d for the OA-lane throughput measurement (local only, never committed)
v4/store-r6-*/
# track T-FMT (round 5): reflink copies of store-dev and store-reh-7d for the family-format read-path check (local only, never committed)
v4/store-fmt-*/
# track T-BATCH (round 5): reflink copies of store-reh-7d for the batch-API volume pilot and batch-mode runs (local only, never committed)
v4/store-batch-*/

# Backup-exclusion markers (backup convention; never tracked)
.exclude_from_backup

# Eval sets' whole texts (D790): third-party documents, never committed. Readers look in a set's own texts/
# (a fresh freeze) and then in the eval-text cache ($STACK_EVAL_TEXTS_DIR; tools/fetch_eval_texts.py fills it).
evals/*/*/texts/
